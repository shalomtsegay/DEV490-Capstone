  m_Name: SAFE_EXIT_HELP
  m_EditorClassIdentifier: 
  question: How should you assist a client with disembarking safely?
  answers:
  - Unlock all securements, guide them to the ramp, and help them exit
  - Push their wheelchair off quickly
  - Let another passenger assist
  - Wait inside while they exit
