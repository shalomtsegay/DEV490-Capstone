  m_Script: {fileID: 11500000, guid: 0c81d0799aa6a4414aeba22f42827a32, type: 3}
  m_Name: NAV_TO_SECUREMENT
  m_EditorClassIdentifier: 
  question: What are the correct instructions to give the client about where to go?
  answers:
  - Direct them to the designated securement area and offer assistance
  - Let them choose any seat they like
  - Ask them to sit near the front regardless of space
  - Tell them to wait while you finish your route
